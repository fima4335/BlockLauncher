{
  "name": "block-launcher",
  "version": "0.1.0",
  "description": "BlockLauncher — современный Minecraft лаунчер с уникальной системой анализа зависимостей модов (как T-Launcher, но умнее)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "analyze": "ts-node src/core/mod-intelligence.ts",
    "test:mod": "ts-node src/core/mod-intelligence.ts"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "modrinth",
    "mods",
    "modpack",
    "tlauncher",
    "create",
    "dependencies"
  ],
  "author": "BlockLauncher Team",
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "@vitejs/plugin-react": "^4.3.1"
  },
  "engines": {
    "node": ">=18"
  }
}
